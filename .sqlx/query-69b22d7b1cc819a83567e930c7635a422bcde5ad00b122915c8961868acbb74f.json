  "query": "\n        SELECT c.id, c.provider as \"provider: ConnectionProvider\", c.external_account\n        FROM connections c\n        JOIN professionals p ON p.user_id = c.user_id\n        JOIN agents a ON a.professional_id = p.id\n        WHERE a.id = $1\n        ORDER BY c.provider\n        ",
