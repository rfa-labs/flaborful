# Copy to `.env` and fill in real values. The `.env` file is gitignored.

DATABASE_URL=postgres://user:pass@localhost:5432/flaborful

# GitHub OAuth (create at github.com/settings/developers)
# Callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
# Enable: Google Docs API, Google Drive API. Scopes: documents, drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# App secrets
CREDENTIAL_KEY=
JWT_SECRET=
RUST_LOG=info

# Qdrant (derived vector index)
QDRANT_URL=
QDRANT_API_KEY=

# Ollama / inference
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
ORCHESTRATOR_MODEL=
WORKER_MODEL=
EMBEDDING_MODEL=

# RunPod serverless training
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
API_BASE_URL=

# Cloudflare Workers AI (inference + LoRA upload)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_WORKER_MODEL=

# Cloudflare R2 (adapter storage)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Coding-agent execution (Sprite backend)
SPRITES_TOKEN=
SPRITES_ORG=
# Server Anthropic key — the fallback for Sprite runs (e.g. onboarding, on the platform's dime).
ANTHROPIC_API_KEY=
# Per-TaskKind coding model defaults (Phase 1). Blank => built-in defaults (Implement=frontier,
# Ingest=cheap). Override to tune cost without a redeploy.
FLABORFUL_MODEL_IMPLEMENT=
FLABORFUL_MODEL_INGEST=

# Optimizer edge — the fbx-agent coding orchestrator routes every LLM call through it
# (route/cache/quality-gate/meter). OPTIMIZER_BASE_URL is the OpenAI-compatible edge (…/v1);
# OPTIMIZER_API_KEY is the server-level sk-opt-… (agents may bring their own, stored encrypted).
OPTIMIZER_BASE_URL=
OPTIMIZER_API_KEY=
# Optional upstream provider key forwarded as x-provider-key. Leave blank to let the optimizer
# resolve the provider key server/tenant-side. When OPTIMIZER_BASE_URL + OPTIMIZER_API_KEY are set,
# the InferenceClient (orchestrate/worker) also routes through the edge (route/cache/gate/meter).
# fbx-agent is installed on the sprite from the PUBLIC npm package @rfa-labs/fbx-agent (same
# pattern as Claude Code / Codex — no auth needed). Optional override: a full shell command to
# install fbx-agent instead of the default npm install (e.g. for dev or a pinned artifact).
FBX_AGENT_INSTALL=
