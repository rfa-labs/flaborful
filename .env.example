# Copy to `.env` and fill in real values. The `.env` file is gitignored.

DATABASE_URL=postgres://user:pass@localhost:5432/flaborful

# GitHub OAuth (create at github.com/settings/developers)
# Callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/auth/github/callback

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials)
# Enable: Google Docs API, Google Drive API. Scopes: documents, drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# App secrets
CREDENTIAL_KEY=
JWT_SECRET=
RUST_LOG=info

# Qdrant (derived vector index)
QDRANT_URL=
QDRANT_API_KEY=

# Ollama / inference
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
ORCHESTRATOR_MODEL=
WORKER_MODEL=
EMBEDDING_MODEL=

# RunPod serverless training
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
API_BASE_URL=

# Cloudflare Workers AI (inference + LoRA upload)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_WORKER_MODEL=

# Cloudflare R2 (adapter storage)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
